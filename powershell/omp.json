{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none",
            "windows": "\ue70f"
          },
          "template": " {{ if .WSL -}} WSL at {{ end }}{{ .Icon }} ",
          "type": "os",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": " {{ .UserName -}} ",
          "foreground": "#d80d61",
          "powerline_symbol": "\ue0b2",
          "background": "#1b1b1b",
          "type": "session",
          "style": "powerline",
          "invert_powerline": true
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "- root \uf0e7",
          "foreground": "#d80d61",
          "powerline_symbol": "\ue0b0",
          "background": "#1b1b1b",
          "type": "root",
          "style": "powerline"
        },
        {
          "properties": {
            "cache_duration": "none",
            "time_format": "02/01/2006 15:04:05"
          },
          "template": " {{ .CurrentDate | date .Format }} ",
          "foreground": "#ffbb00",
          "powerline_symbol": "\ue0b1",
          "background": "#1b1b1b",
          "type": "time",
          "style": "powerline",
          "invert_powerline": true
        },
        {
          "properties": {
            "cache_duration": "none",
            "folder_separator_icon": "/",
            "mapped_locations": {
              "~\\source\\repos": "~/#coding"
            },
            "mapped_locations_enabled": true,
            "style": "full"
          },
          "template": "\ue5ff {{ path .Path .Location }} ",
          "foreground": "#33dd2d",
          "powerline_symbol": "\ue0b0",
          "background": "#1b1b1b",
          "type": "path",
          "style": "powerline"
        },
        {
          "properties": {
            "cache_duration": "none",
            "fetch_stash_count": true
          },
          "template": " {{- .UpstreamIcon }}{{ .HEAD }}{{ if gt .StashCount 0 }} \udb80\udd93 {{ .StashCount }}{{ end }} ",
          "foreground": "#3a86ff",
          "powerline_symbol": "\ue0b0",
          "background": "#1b1b1b",
          "type": "git",
          "style": "powerline"
        },
        {
          "properties": {
            "cache_duration": "none",
            "display_mode": "environment",
            "fetch_version": true,
            "fetch_virtual_env": true
          },
          "leading_diamond": " \ue0b2",
          "trailing_diamond": "\ue0b0",
          "template": " \ue73c {{ .Full }} {{ .Venv }} ",
          "foreground": "#ffce42",
          "background": "#1b1b1b",
          "type": "python",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none",
            "display_mode": "context",
            "fetch_version": true
          },
          "leading_diamond": " \ue0b2",
          "trailing_diamond": "\ue0b0",
          "template": " \ue718 {{ .Full }} ",
          "foreground": "#2ac724",
          "background": "#1b1b1b",
          "type": "node",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none",
            "display_mode": "context",
            "fetch_version": true
          },
          "leading_diamond": " \ue0b2",
          "trailing_diamond": "\ue0b0",
          "template": " {{ `.NET` }} {{ .Full }} ",
          "foreground": "#5c2d91",
          "background": "#1b1b1b",
          "type": "dotnet",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none",
            "display_mode": "context",
            "fetch_version": true
          },
          "leading_diamond": " \ue0b2",
          "trailing_diamond": "\ue0b0",
          "template": " GO {{ .Full }} ",
          "foreground": "#007d9c",
          "background": "#1b1b1b",
          "type": "go",
          "style": "diamond"
        },
        {
          "properties": {
            "cache_duration": "none"
          },
          "leading_diamond": " \ue0b2",
          "trailing_diamond": "\ue0b0",
          "template": "{{ if gt .Code 0 }} \uf00d {{ end }}",
          "foreground": "#1b1b1b",
          "background": "#f1184c",
          "type": "exit",
          "style": "diamond"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "\udb80\udd3e ",
          "foreground": "#d80d61",
          "type": "text",
          "style": "plain"
        }
      ],
      "newline": true
    }
  ],
  "version": 3
}
